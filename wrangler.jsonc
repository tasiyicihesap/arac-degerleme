{
  // OTOKABUL araç alım sitesi — Cloudflare Workers + D1
  "name": "arac-degerleme",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api.php", "/yonetim/api.php", "/yuklemeler/*", "/sitemap.xml", "/arac-degerleme", "/arac-degerleme/*", "/rehber", "/rehber/*", "/mtv-hesaplama", "/mtv-hesaplama/", "/noter-masrafi-hesaplama", "/noter-masrafi-hesaplama/", "/otv-hesaplama", "/otv-hesaplama/", "/arac-muayene-ucreti-hesaplama", "/arac-muayene-ucreti-hesaplama/", "/yakit-hesaplama", "/yakit-hesaplama/", "/elektrikli-arac-sarj-hesaplama", "/elektrikli-arac-sarj-hesaplama/", "/kw-hp-donusturme", "/kw-hp-donusturme/", "/lastik-ebadi-hesaplama", "/lastik-ebadi-hesaplama/", "/yillik-km-hesaplama", "/yillik-km-hesaplama/", "/plaka-il-kodlari", "/plaka-il-kodlari/", "/hesaplamalar", "/hesaplamalar/"]
  },
  // Veritabanı ilk yayında Cloudflare tarafından otomatik oluşturulur
  // otokabul.com.tr ve www alan adları bu siteye bağlı
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    { "pattern": "otokabul.com.tr", "custom_domain": true },
    { "pattern": "www.otokabul.com.tr", "custom_domain": true }
  ],
  "d1_databases": [{ "binding": "DB", "database_name": "otokabul-db" }],
  // bildirim e-postaları bilgi@otokabul.com.tr adresinden, Cloudflare'de doğrulanmış adreslere gider
  "send_email": [{ "name": "EPOSTA" }],
  "observability": { "enabled": true }
}
